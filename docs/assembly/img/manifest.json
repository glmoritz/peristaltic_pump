     "insert_m3",
     6
    ]
   ]
  },
  {
   "n": 2,
   "section": "Pump head",
   "title": "Motor",
   "note": "Motor boss into the round pocket under the base. Cable facing the back (+y), where the electronics box will be.",
   "times": 1,
   "img": "docs/assembly/img/step_02.png",
   "callouts": [
    [
     "motor",
     1
    ],
    [
     "m3x8",
     4
    ]
   ]
  },
  {
   "n": 3,
   "section": "Pump head",
   "title": "Rollers — build 3",
   "note": "Slide 2 bearings onto each printed sleeve, flange at the bottom. Make 3.",
   "times": 3,
   "img": "docs/assembly/img/step_03.png",
   "callouts": [
    [
     "sleeve",
     1
    ],
    [
     "bearing",
     2
    ]
   ]
  },
  {
   "n": 4,
   "section": "Pump head",
   "title": "Lower rotor inserts",
   "note": "Press the M4 inserts into the flat top face (the face without the clamp).",
   "times": 1,
   "img": "docs/assembly/img/step_04.png",
   "callouts": [
    [
     "rotor_lower",
     1
    ],
    [
     "insert_m4",
     3
    ]
   ]
  },
  {
   "n": 5,
   "section": "Pump head",
   "title": "Rollers on the rotor",
   "note": "Stand each roller over an insert.",
   "times": 1,
   "img": "docs/assembly/img/step_05.png",
   "callouts": [
    [
     "roller",
     3
    ]
   ]
  },
  {
   "n": 6,
   "section": "Pump head",
   "title": "Upper rotor",
   "note": "Bosses down onto the bearings. Tighten until the rollers spin freely with no up-down play.",
   "times": 1,
   "img": "docs/assembly/img/step_06.png",
   "callouts": [
    [
     "rotor_upper",
     1
    ],
    [
     "m4x25",
     3
    ]
   ]
  },
  {
   "n": 7,
   "section": "Pump head",
   "title": "Rotor onto the motor",
   "note": "First drop 2 M3 nuts into the slots under the clamp. Slide the rotor over the motor hub. Tighten each grub screw through the hole in the front wall (1.5 mm hex key), turning the rotor between them.",
   "times": 1,
   "img": "docs/assembly/img/step_07.png",
   "callouts": [
    [
     "rotor_asm",
     1
    ],
    [
     "nut_m3",
     2
    ],
    [
     "grub_m3",
     2
    ]
   ]
  },
  {
   "n": 8,
   "section": "Pump head",
   "title": "Track insert",
   "note": "Start with the 2.6 mm insert (2 dimples). The 2.4 and 2.8 inserts are for tuning: use the loosest one that still pumps.",
   "times": 1,
   "img": "docs/assembly/img/step_08.png",
   "callouts": [
    [
     "track",
     1
    ]
   ]
  },
  {
   "n": 9,
   "section": "Pump head",
   "title": "Hose",
   "note": "Push the hose between the rollers and the track while turning the rotor by hand. Both legs go into the U-slots in the front wall.",
   "times": 1,
   "img": "docs/assembly/img/step_09.png",
   "callouts": [
    [
     "hose",
     1
    ]
   ]
  },
  {
   "n": 10,
   "section": "Pump head",
   "title": "Lid",
   "note": "The tabs under the lid press the hose into the U-slots so it cannot creep.",
   "times": 1,
   "img": "docs/assembly/img/step_10.png",
   "callouts": [
    [
     "pump_lid",
     1
    ],
    [
     "m3x10",
     4
    ]
   ]
  },
  {
   "n": 11,
   "section": "Reservoir",
   "title": "Heat-set inserts",
   "note": "4 in the corner columns (lid), 2 in each pair of sensor bosses. The bosses are blind: the wall stays watertight. Test-fill the box with water before going on.",
   "times": 1,
   "img": "docs/assembly/img/step_11.png",
   "callouts": [
    [
     "res_body",
     1
    ],
    [
     "insert_m3",
     8
    ]
   ]
  },
  {
   "n": 12,
   "section": "Reservoir",
   "title": "Strainer",
   "note": "Into the ring on the floor, in the corner nearest the pump.",
   "times": 1,
   "img": "docs/assembly/img/step_12.png",
   "callouts": [
    [
     "strainer",
     1
    ]
   ]
  },
  {
   "n": 13,
   "section": "Reservoir",
   "title": "Level sensors",
   "note": "L sensor on the front wall, H sensor on the right wall. Sensing face against the wall, cable pointing down. Leave the screws slightly loose: the slots adjust the height.",
   "times": 1,
   "img": "docs/assembly/img/step_13.png",
