{
 "steps": [
  {
   "n": 1,
   "section": "Pump head",
   "title": "Heat-set inserts",
   "note": "Soldering iron at ~220 °C, press each insert until it is flush. 4 in the wall tops (lid), 2 in the back wall (electronics box).",
   "times": 1,
   "img": "docs/assembly/img/step_01.png",
   "callouts": [
