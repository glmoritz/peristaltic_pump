/*
 * ESP32-C3 SuperMini on the pump perfboard (docs/electronics.md §4,
 * design.md §5.2). GPIO2/8/9 are strapping pins and 18/19 are USB, so they
 * are left alone; GPIO8 keeps driving the on-board LED.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		pump-driver = &tmc2209;
		pump-motion = &pump_motion;
	};

	zephyr,user {
		/*
		 * Level sensors through the R/C network of electronics.md §5,
		 * which already pulls the line, so no internal pull here.
		 * [TBC Q2] ACTIVE_LOW assumes an NPN normally-open sensor that
		 * pulls its output low when it sees water. Flip to
		 * GPIO_ACTIVE_HIGH for a push-pull or PNP sensor.
		 */
		level-low-gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
		level-high-gpios = <&gpio0 1 GPIO_ACTIVE_LOW>;

		/* Optional parts (electronics.md §4). */
		buzzer-gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
		button-gpios = <&gpio0 21 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	};

	/*
	 * TMC2209 StepStick in standalone mode: EN only. MS1/MS2 are left
	 * open (8 microsteps), so no m0/m1 GPIOs; micro-step-res records the
	 * strapping. PDN_UART on GPIO6/7 is wired for phase 2 (design.md §6.5).
	 */
	tmc2209: tmc2209 {
		compatible = "adi,tmc2209";
		micro-step-res = <8>;
		en-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;
	};

	/*
	 * Step/dir generated by the CPU, timed by a hardware timer instead of
	 * the work queue: jitter at 3-20 RPM is audible (design.md §6.5).
	 */
	pump_motion: pump-motion {
		compatible = "zephyr,gpio-step-dir-stepper-ctrl";
		step-gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
		dir-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
		counter = <&step_counter>;
		stepper-driver = <&tmc2209>;
	};
};

/*
 * Timer group 0, timer 0. The counter device is the child node
 * (espressif,esp32-counter); the prescaler lives on the parent timer.
 * APB 80 MHz / 80 = 1 MHz: 1 us step-interval resolution.
 */
&timer0 {
	status = "okay";
	prescaler = <80>;

	step_counter: counter {
		status = "okay";
	};
};
